{
  "compilerOptions": {
    // es2020, not higher: `?.` and `??` are the newest syntax the source uses and both are
    // ES2020, so es2022 emits byte-identical output. es2020 runs on Node 14+, below the
    // engines.node >= 18 floor.
    "target": "es2020",
    "module": "es6",
    // node10 resolution is still intentional: it keeps the classic top-level `types`/`main`
    // path working for consumers on older TypeScript (it ignores `exports`). TypeScript 6.0
    // deprecated it; ignoreDeprecations suppresses that until a deliberate compat change.
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "declaration": true,
    "rootDir": "src",
    "outDir": "esm",
    "allowSyntheticDefaultImports": true,
    "removeComments": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "experimentalDecorators": true
  },
  "files": [
    "node_modules/typescript/lib/lib.es2015.d.ts",
    "node_modules/typescript/lib/lib.dom.d.ts",
    "src/index.ts"
  ],
  "include": [
    "*.ts",
    "**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "*/__tests__",
    "*/__mocks__",
    "dist"
  ]
}
